{
  "expo": {
    "name": "OrbitX",
    "slug": "orbitx",
    "owner": "orbitxworlds-team",
    "scheme": "orbitx",
    "version": "0.1.0",
    "platforms": ["android", "ios", "web"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.orbitx.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "ai.orbitx.app",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "orbitx"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#000000",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "d3034f0d-841d-41c2-9435-b83b501c685a"
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/splash-icon.png",
          "imageWidth": 1
        }
      ],
      [
        "expo-router",
        {
          "root": "./app"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ]
  }
}
