{
  "buildCommand": "EXPO_NO_METRO_LAZY=1 npx expo export -p web",
  "outputDirectory": "dist",
  "devCommand": "npx expo start --web",
  "installCommand": "npm ci",
  "cleanUrls": true,
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!_expo/|favicon.ico).*)",
      "destination": "/"
    }
  ]
}
