# Public client values — safe to set on Vercel as EXPO_PUBLIC_*
EXPO_PUBLIC_SUPABASE_URL=https://ffjipnkhcebjvttliptb.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EXPO_PUBLIC_APP_URL=https://orbitxcity.vercel.app
# Privy is email/phone login that creates an in-app Solana wallet.
# Do not use it to connect Phantom or Jupiter.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# Never put these in Vercel EXPO_PUBLIC_* or the Expo client.
# Set them as Supabase Edge Function secrets on project ffjipnkhcebjvttliptb:
# NVIDIA_API_KEY
# GROQ_API_KEY
# GEMINI_API_KEY
# OPENROUTER_API_KEY
# SUPABASE_SERVICE_ROLE_KEY
